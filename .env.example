# =============================================================================
# Environment contract
# =============================================================================
# This file documents every variable the stack reads. It is NOT loaded at
# runtime. Use it as the checklist when populating Doppler.
#
# You do not need any of it to start. Every value below has a development
# default, so a fresh clone runs as-is:
#
#   docker compose up -d --build        # terminal 1: infrastructure
#   bun run dev                         # terminal 2: apps (hot reload)
#
# Those defaults are insecure and obvious on sight. Before the stack leaves
# your machine, put real values in Doppler and prefix both commands:
#
#   doppler setup                       # once per machine
#   doppler run -- bun run dev
#   doppler run -- docker compose up -d --build
# =============================================================================

NODE_ENV=development
COMPOSE_PROJECT_NAME=app

# --- public URLs -------------------------------------------------------------
# Domains are resolved from here, never hardcoded in nginx/compose.
APP_DOMAIN=app.localhost
ADMIN_DOMAIN=admin.app.localhost
FRONTEND_URL=http://app.localhost:8080
ADMIN_URL=http://admin.app.localhost:8080
API_URL=http://app.localhost:8080/api

# --- ports (host side; containers use fixed internal ports) ------------------
# Not 3000: that port is the most contested one in JS development and a
# second project holding it makes the backend fail to bind, silently.
BACKEND_PORT=3100
FRONTEND_PORT=5173
ADMIN_PORT=5174
NGINX_HTTP_PORT=8080
PROMETHEUS_PORT=9090

# --- postgres ----------------------------------------------------------------
POSTGRES_USER=app
POSTGRES_PASSWORD=change-me-in-doppler
POSTGRES_DB=app
# Login for the least-privilege `monitoring` role postgres_exporter uses.
POSTGRES_MONITORING_PASSWORD=change-me-in-doppler
POSTGRES_HOST=localhost
# Not 5432: a locally installed PostgreSQL already owns it on most machines,
# and the container listens on 5432 internally regardless.
POSTGRES_PORT=55432
# Backend (running on the host in dev) talks to the mapped port.
DATABASE_URL=postgresql://app:app@localhost:55432/app?schema=public

# --- auth --------------------------------------------------------------------
JWT_SECRET=change-me-in-doppler
JWT_EXPIRES_IN=7d
# --- admin sign-in -----------------------------------------------------------
# Two stages. First the operator proves who they are with Google or GitHub and
# the verified address must equal ADMIN_EMAIL; then they enter these credentials.
#
# Leaving ADMIN_EMAIL empty skips the first stage — but only outside production,
# where it is required and its absence stops every sign-in.
ADMIN_EMAIL=
# Default to admin / admin in development. Production refuses to start if the
# password is still "admin" or is shorter than 12 characters.
ADMIN_USERNAME=admin
ADMIN_PASSWORD=change-me-in-doppler

# Configure whichever providers you want offered. A provider with only half its
# credentials is treated as not configured and is not shown.
# Authorised redirect URI, registered with the provider exactly:
#   $ADMIN_URL/api/auth/oauth/<provider>/callback
OAUTH_GOOGLE_CLIENT_ID=
OAUTH_GOOGLE_CLIENT_SECRET=
OAUTH_GITHUB_CLIENT_ID=
OAUTH_GITHUB_CLIENT_SECRET=

# --- observability -----------------------------------------------------------
# Prometheus runs with --web.route-prefix=/prometheus; the API lives under it.
PROMETHEUS_URL=http://localhost:9090/prometheus
GRAFANA_ADMIN_USER=admin
GRAFANA_ADMIN_PASSWORD=change-me-in-doppler
# Grafana is served under the /grafana sub-path of the admin domain.
GRAFANA_ROOT_URL=http://admin.app.localhost:8080/grafana

# --- backups (Backrest) ------------------------------------------------------
# Backrest orchestrates restic and brings its own web UI at /backrest on the
# admin domain. It is configured through that UI on first run, not from here:
# the repository, its password, the schedule and the retention policy all live
# in Backrest's own config volume.
#
# The one piece this stack supplies is the hook that produces something worth
# backing up. Add it to your plan as a CONDITION_SNAPSHOT_START command:
#
#   /usr/local/bin/dump-postgres.sh
#
# It reads POSTGRES_* from the container environment (already wired in compose)
# and writes /dumps/<database>.dump, which is the path your plan should back up.

# --- nginx basic auth (guards /prometheus, which has no login of its own) ---
NGINX_BASIC_AUTH_USER=ops
NGINX_BASIC_AUTH_PASSWORD=change-me-in-doppler

# --- cloudflare tunnel -------------------------------------------------------
# Token-mode tunnel. Ingress rules point at http://nginx:80 in the CF dashboard.
TUNNEL_TOKEN=

# --- deploy ------------------------------------------------------------------
REGISTRY=ghcr.io
IMAGE_NAMESPACE=your-org/your-repo
IMAGE_TAG=latest
